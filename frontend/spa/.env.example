# API Configuration
# Use /api for local development (proxied by Vite to avoid CORS issues)
# Use http://localhost:8101 for direct backend access (requires CORS enabled)
VITE_API_ORG_URL=/api

# OpenID Connect provider the SPA logs in at: its issuer URL and the SPA's client id there.
# Keycloak (the realm; this is the one Quarkus Dev Services start):
VITE_OIDC_PROVIDER_URL=http://localhost:8554/realms/quarkus
VITE_OIDC_CLIENT_ID=quarkus-app
# Authentik (the application, trailing slash included). It only issues refresh tokens with offline_access:
# VITE_OIDC_PROVIDER_URL=http://localhost:9100/application/o/hopps/
# VITE_OIDC_CLIENT_ID=hopps-spa
# VITE_OIDC_SCOPE=openid profile email offline_access
