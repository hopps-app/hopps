# API Configuration
# Use /api for local development (proxied by Vite to avoid CORS issues)
# Use http://localhost:8101 for direct backend access (requires CORS enabled)
VITE_API_ORG_URL=/api

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8554
VITE_KEYCLOAK_REALM=quarkus
VITE_KEYCLOAK_CLIENT_ID=quarkus-app

# External OIDC provider (optional, e.g. a partner's Authentik), replaces Keycloak for login when set.
# Issuer URL of the provider's application, and the SPA's client id there. Self-registration is then off.
# VITE_OIDC_PROVIDER_URL=http://localhost:9100/application/o/hopps/
# VITE_OIDC_CLIENT_ID=hopps-spa
