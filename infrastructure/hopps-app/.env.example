# Copy to .env and fill in. Everything without a value below is required.
# `docker compose up -d` will refuse to work properly without them.

# ---------------------------------------------------------------- versions --
# org, az-document-ai and zugferd are released together and share one tag.
TAG=967
FRONTEND_TAG=1168
KEYCLOAK_TAG=193-keycloak-26.2.1

# ------------------------------------------------------------- public URLs --
# How the browser reaches each component. For a real deployment put a reverse
# proxy with TLS in front and use https:// hostnames here. No trailing slash.
PUBLIC_SPA_URL=http://localhost:8080
PUBLIC_ORG_URL=http://localhost:8101
PUBLIC_KEYCLOAK_URL=http://localhost:8092

# Uncomment and set to "xforwarded" when Keycloak sits behind a reverse proxy that
# terminates TLS. Leave it out entirely otherwise - an empty value is rejected.
#KC_PROXY_HEADERS=xforwarded

# ------------------------------------------------------- published ports ----
SPA_PORT=8080
ORG_PORT=8101
KEYCLOAK_PORT=8092
# Bound to 127.0.0.1 only.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# ----------------------------------------------------------------- secrets --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Object storage for uploaded receipts. Back up the minio_data volume.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_REGION=eu-central-1

# ------------------------------------------------------- external services --
# Azure Document Intelligence - required, az-document-ai will not start without it.
HOPPS_AZURE_DOCUMENT_AI_ENDPOINT=
HOPPS_AZURE_DOCUMENT_AI_KEY=

# OpenAI, used by az-document-ai and zugferd for field extraction.
OPENAI_API_KEY=

# ------------------------------------------------------------ branding -----
VITE_TITLE=Hopps
VITE_GENERAL_DATE_FORMAT=dd.MM.yyyy
VITE_GENERAL_CURRENCY_SYMBOL_AFTER=€
VITE_ALPHA_VERSION=false

# ------------------------------------------- Impressum & Datenschutz --------
# You are responsible for the legal pages of your instance. Two ways to provide
# them (a URL wins over a mounted file; leave both empty to hide the page):
#   1. Link an existing page:
#        HOPPS_IMPRINT_URL=https://example.org/impressum
#        HOPPS_PRIVACY_URL=https://example.org/datenschutz
#   2. Mount your own content: enable the `./legal:/app/legal:ro` volume in
#      docker-compose.yaml and drop impressum.html / datenschutz.html in ./legal.
# See legal/README.md for details and templates.
HOPPS_IMPRINT_URL=
HOPPS_PRIVACY_URL=

# ------------------------------------------------- external identity provider --
# Optional: let people sign in with an existing OpenID Connect provider
# (Authentik, Entra ID, Google Workspace, another Keycloak, ...) instead of a
# password managed here. Leave IDP_ENABLED=false to keep local logins only.
#
# Applied on the FIRST start only, together with the rest of the realm. To add a
# provider to a running installation, use the Keycloak admin console instead
# (Identity providers -> OpenID Connect v1.0).
#
# Whitelist this redirect URI at the provider:
#   <PUBLIC_KEYCLOAK_URL>/realms/quarkus/broker/<IDP_ALIAS>/endpoint
#
# Setup walkthrough, including a local Authentik to test against: EXTERNAL-IDP.md
IDP_ENABLED=false
# Internal name. Appears in the redirect URI above and selects the button logo
# in the login theme - see EXTERNAL-IDP.md, "Showing the provider's logo".
IDP_ALIAS=oidc
# Button caption on the login page.
IDP_DISPLAY_NAME=Single sign-on
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# Endpoints, straight from the provider's /.well-known/openid-configuration.
# authorization_endpoint and end_session_endpoint are opened in the user's
# BROWSER; the others are called by Keycloak itself and may use an internal
# address. IDP_ISSUER must match the "iss" claim byte for byte, trailing slash
# included. https:// is required unless REALM_SSL_REQUIRED is relaxed.
IDP_AUTHORIZATION_URL=
IDP_TOKEN_URL=
IDP_USERINFO_URL=
IDP_JWKS_URL=
IDP_LOGOUT_URL=
IDP_ISSUER=

# LOCAL TESTING ONLY. Keycloak refuses plain-http identity provider URLs; setting
# this to "none" turns that check off so a local Authentik can be used without TLS.
# Never set this in a real deployment - it also disables Keycloak's own HTTPS
# requirement for the realm. See EXTERNAL-IDP.md, "Trying it locally with Authentik".
REALM_SSL_REQUIRED=external
