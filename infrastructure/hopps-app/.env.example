# Copy to .env and fill in. Everything without a value below is required,
# unless its comment says optional or it belongs to a part you did not enable.
# `docker compose up -d` will refuse to work properly without them.

# ------------------------------------------------------- identity provider --
# Who manages the user accounts:
#   keycloak   Hopps's own Keycloak (default). Fill in block B below; the
#              Keycloak overlay is already in COMPOSE_FILE.
#   authentik  An existing Authentik instance. Fill in block A below and
#              remove docker-compose.keycloak.yaml from COMPOSE_FILE.
HOPPS_AUTH_PROVIDER=keycloak

# ---------------------------------------------------------- optional parts --
# docker-compose.yaml is the core: frontend, org, zugferd and postgres, with
# uploaded files on a local volume. Overlays add to it; list the ones you want
# in COMPOSE_FILE:
#
#   docker-compose.keycloak.yaml  Hopps's own Keycloak (+ mailpit). Required
#                                 with HOPPS_AUTH_PROVIDER=keycloak, remove it
#                                 with authentik.
#   docker-compose.s3.yaml        Files in MinIO instead of the local volume.
#                                 Fill in block C below.
#   docker-compose.document-ai.yaml
#                                 Automatic reading of receipts that are not
#                                 ZUGFeRD e-invoices (photos, scans, plain
#                                 PDFs). Without it those are entered by hand.
#                                 Fill in block D and OPENAI_API_KEY below.
#
COMPOSE_FILE=docker-compose.yaml:docker-compose.keycloak.yaml
# With MinIO as well:
#COMPOSE_FILE=docker-compose.yaml:docker-compose.keycloak.yaml:docker-compose.s3.yaml
# With Authentik instead of Keycloak:
#COMPOSE_FILE=docker-compose.yaml
# Append ":docker-compose.document-ai.yaml" to any of these for document AI.
# Makes the ":" above work on Windows too, whose default separator is ";".
COMPOSE_PATH_SEPARATOR=:

# ---------------------------------------------------------------- versions --
# org, az-document-ai and zugferd are released together and share one tag.
TAG=967
FRONTEND_TAG=1168

# ------------------------------------------------------------- public URLs --
# How the browser reaches each component. For a real deployment put a reverse
# proxy with TLS in front and use https:// hostnames here. No trailing slash.
PUBLIC_SPA_URL=http://localhost:8080
PUBLIC_ORG_URL=http://localhost:8101

# ------------------------------------------------------- published ports ----
SPA_PORT=8080
ORG_PORT=8101
# Bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# ----------------------------------------------------------------- secrets --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ------------------------------------------------------- external services --
# OpenAI. Required with docker-compose.document-ai.yaml. Optional otherwise:
# zugferd uses it to suggest tags for e-invoices and does without them when it
# is empty.
OPENAI_API_KEY=

# ------------------------------------------------------------ branding -----
VITE_TITLE=Hopps
VITE_GENERAL_DATE_FORMAT=dd.MM.yyyy
VITE_GENERAL_CURRENCY_SYMBOL_AFTER=€
VITE_ALPHA_VERSION=false

# ------------------------------------------- Impressum & Datenschutz --------
# You are responsible for the legal pages of your instance. Two ways to provide
# them (a URL wins over a mounted file; leave both empty to hide the page):
#   1. Link an existing page:
#        HOPPS_IMPRINT_URL=https://example.org/impressum
#        HOPPS_PRIVACY_URL=https://example.org/datenschutz
#   2. Mount your own content: enable the `./legal:/app/legal:ro` volume in
#      docker-compose.yaml and drop impressum.html / datenschutz.html in ./legal.
# See legal/README.md for details and templates.
HOPPS_IMPRINT_URL=
HOPPS_PRIVACY_URL=

# ============================================================================
# A) Authentik (HOPPS_AUTH_PROVIDER=authentik)
# ============================================================================
# Required with HOPPS_AUTH_PROVIDER=authentik, ignored otherwise.
# People log in with their Authentik account; registering an organization is
# off, and inviting someone links their existing account or creates one there.
# Setup in Authentik: README.md, "Identity provider".

# Issuer of the Hopps application in Authentik, exactly as its
# /.well-known/openid-configuration reports it, trailing slash included, e.g.
# https://auth.example.org/application/o/hopps/
# Opened by the browser, so it must be publicly reachable.
PUBLIC_OIDC_ISSUER_URL=
# Client ID of the OAuth2/OpenID provider behind that application.
OIDC_CLIENT_ID=
# Only if the org container cannot reach the issuer under its public address
# (split-horizon DNS, Authentik on the same host). Same URL, internal host.
#OIDC_INTERNAL_URL=http://authentik-server:9000/application/o/hopps/

# Base URL of Authentik, no trailing slash, e.g. https://auth.example.org
# Authentik builds the set-password links from it, so use the address invited
# people can open.
AUTHENTIK_URL=
# Token of a service account allowed to view, create and delete users
# (Directory -> Tokens and App passwords, intent "API").
AUTHENTIK_API_TOKEN=
# Optional. UUID of an Authentik "Email" stage that mails invited people their
# set-password link. Left empty, the inviting admin gets the link to pass on.
AUTHENTIK_EMAIL_STAGE_ID=

# ============================================================================
# B) Keycloak (HOPPS_AUTH_PROVIDER=keycloak)
# ============================================================================
# Required with HOPPS_AUTH_PROVIDER=keycloak (the default), together with
# docker-compose.keycloak.yaml in COMPOSE_FILE. Ignored otherwise.
KEYCLOAK_TAG=193-keycloak-26.2.1
PUBLIC_KEYCLOAK_URL=http://localhost:8092
KEYCLOAK_PORT=8092
# Bound to 127.0.0.1 only. Web UI of the mail catcher Keycloak sends through.
MAILPIT_UI_PORT=8025

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Uncomment and set to "xforwarded" when Keycloak sits behind a reverse proxy that
# terminates TLS. Leave it out entirely otherwise - an empty value is rejected.
#KC_PROXY_HEADERS=xforwarded

# --------------------------------- Keycloak: brokering to another provider --
# Optional: let people sign in at Keycloak with an existing OpenID Connect
# provider (Authentik, Entra ID, Google Workspace, another Keycloak, ...) in
# addition to a password managed there. Accounts are still created in Keycloak.
# Leave IDP_ENABLED=false to keep Keycloak logins only.
#
# Applied on the FIRST start only, together with the rest of the realm. To add a
# provider to a running installation, use the Keycloak admin console instead
# (Identity providers -> OpenID Connect v1.0).
#
# Whitelist this redirect URI at the provider:
#   <PUBLIC_KEYCLOAK_URL>/realms/quarkus/broker/<IDP_ALIAS>/endpoint
#
# Setup walkthrough, including a local Authentik to test against: EXTERNAL-IDP.md
IDP_ENABLED=false
# Internal name. Appears in the redirect URI above and selects the button logo
# in the login theme - see EXTERNAL-IDP.md, "Showing the provider's logo".
IDP_ALIAS=oidc
# Button caption on the login page.
IDP_DISPLAY_NAME=Single sign-on
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# Endpoints, straight from the provider's /.well-known/openid-configuration.
# authorization_endpoint and end_session_endpoint are opened in the user's
# BROWSER; the others are called by Keycloak itself and may use an internal
# address. IDP_ISSUER must match the "iss" claim byte for byte, trailing slash
# included. https:// is required unless REALM_SSL_REQUIRED is relaxed.
IDP_AUTHORIZATION_URL=
IDP_TOKEN_URL=
IDP_USERINFO_URL=
IDP_JWKS_URL=
IDP_LOGOUT_URL=
IDP_ISSUER=

# LOCAL TESTING ONLY. Keycloak refuses plain-http identity provider URLs; setting
# this to "none" turns that check off so a local Authentik can be used without TLS.
# Never set this in a real deployment - it also disables Keycloak's own HTTPS
# requirement for the realm. See EXTERNAL-IDP.md, "Trying it locally with Authentik".
REALM_SSL_REQUIRED=external

# ============================================================================
# C) MinIO file storage (only with docker-compose.s3.yaml)
# ============================================================================
# Ignored unless the S3 overlay is in COMPOSE_FILE. Back up the minio_data volume.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_REGION=eu-central-1
# Bound to 127.0.0.1 only.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================================
# D) Document AI (only with docker-compose.document-ai.yaml)
# ============================================================================
# Ignored unless the document AI overlay is in COMPOSE_FILE; then required,
# together with OPENAI_API_KEY under "external services".
# Azure Document Intelligence, the operator's own account.
HOPPS_AZURE_DOCUMENT_AI_ENDPOINT=
HOPPS_AZURE_DOCUMENT_AI_KEY=
