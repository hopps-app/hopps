# WhatsApp Cloud API (REQUIRED in prod)
# Meta App Dashboard > your app > WhatsApp > API Setup / Configuration.
# Register the webhook URL https://<host>/webhooks/whatsapp with the verify token
# below and subscribe to the "messages" field.
HOPPS_WHATSAPP_VERIFY_TOKEN=choose-a-random-string
HOPPS_WHATSAPP_APP_SECRET=your-meta-app-secret
HOPPS_WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
HOPPS_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Optional
# HOPPS_WHATSAPP_GRAPH_API_VERSION=v21.0

# Azure OpenAI (REQUIRED for chat answers)
# Same resource as zugferd / az-document-ai: EU region, DataZoneStandard deployment of gpt-4o-mini.
HOPPS_AZURE_OPENAI_RESOURCE_NAME=your-azure-openai-resource-name
HOPPS_AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
HOPPS_AZURE_OPENAI_KEY=your-azure-openai-key-here
